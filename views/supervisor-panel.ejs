<%- include('partials/header') %>

  <section class="app-section active">
    <div class="supervisor-panel-header">
      <h3 class="panel-welcome">مرحباً بك، <%= role==='admin' ? 'أيها المدير' : 'أيها المشرف' %>
      </h3>
      <div style="display:flex; gap:10px; flex-wrap:wrap;">
        <a href="/daily-attendance" class="btn btn-outline btn-small">📋 التحضير اليومي</a>
        <a href="/supervisor/weekly-reminders" class="btn btn-gold btn-small">📤 تذكير نهاية الأسبوع</a>
        <a href="/supervisor/points-archive" class="btn btn-gold btn-small">🗄️ أرشيف النقاط</a>
        <form method="POST" action="/supervisor/logout">
          <button type="submit" class="btn btn-outline btn-small">تسجيل الخروج</button>
        </form>
      </div>
    </div>

    <script type="application/json"
      id="studentsDataJson"><%- JSON.stringify(students.map(s => ({ id: s.id, name: s.name, group: s.group_name }))) %></script>

    <!-- =========================================================
         1) الحضور: قائمة بالجملة حسب الأسر (التحضير الفردي عبر صفحة التحضير اليومي)
         ========================================================= -->
    <h3 class="panel-group-title">📅 الحضور</h3>

    <div class="panel-box" style="margin-bottom:18px;">
      <h4 style="margin-top:0;">قائمة الحضور حسب الأسر</h4>
      <div class="form-group" style="margin-bottom:14px;">
        <label for="attListSessionSelect">الجلسة</label>
        <select id="attListSessionSelect" class="form-select">
          <% sessions.forEach(sess=> { %>
            <option value="<%= sess.id %>" <%=sess.id===currentSessionId ? 'selected' : '' %>>
              الأسبوع <%= sess.week_number %> — <%= sess.day_name %> (<%= sess.session_date %>)
            </option>
            <% }) %>
        </select>
      </div>

      <div id="familyPickerLevel">
        <div class="family-btn-grid">
          <% allGroups.forEach((g, i)=> { %>
            <button type="button" class="family-btn" onclick="showFamilyAttendance(<%= i %>)">
              <%= g.groupName %>
            </button>
            <% }) %>
        </div>
      </div>

      <div id="familyDetailLevel" class="hidden">
        <button type="button" class="btn btn-outline btn-small" style="margin-bottom:14px;"
          onclick="backToFamilyPicker()">‹ رجوع لقائمة الأسر</button>
        <h5 id="familyDetailTitle" class="attendance-category-title" style="margin-top:0;"></h5>
        <div id="familyDetailBody"></div>
      </div>
    </div>

    <script type="application/json" id="attendanceGroupsDataJson"><%- JSON.stringify(allGroups) %></script>

    <!-- =========================================================
         2) النقاط: إضافة/خصم + إنجاز الذاتي الأسبوعي
         ========================================================= -->
    <h3 class="panel-group-title">🏆 النقاط</h3>

    <div class="panel-grid" style="margin-bottom:18px;">
      <!-- تسجيل مبادرة -->
      <div class="panel-box">
        <h4>🌟 تسجيل مبادرة</h4>
        <form id="initiativeForm">
          <input type="hidden" id="initiativeStudentSelect">
          <div class="form-group">
            <label>اختر الطالب</label>
            <div style="display:flex; gap:10px;">
              <select id="initiativeGroupPicker" class="form-select" style="flex:1;">
                <option value="">اختر الأسرة</option>
              </select>
              <select id="initiativeStudentPicker" class="form-select" style="flex:1;" disabled>
                <option value="">اختر الطالب</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="initiativeCategorySelect">محور المبادرة</label>
            <select id="initiativeCategorySelect" class="form-select">
              <option value="">اختر المحور</option>
              <option value="التقنية">التقنية</option>
              <option value="الأدبية">الأدبية</option>
              <option value="الأصولية">الأصولية</option>
              <option value="المهارية">المهارية</option>
            </select>
          </div>
          <div class="form-group">
            <label for="initiativeAmount">عدد النقاط</label>
            <input type="number" id="initiativeAmount" class="form-input" placeholder="أدخل عدد النقاط" min="1" required>
          </div>

          <div class="form-group" style="display:flex; gap:10px;">
            <button type="button" id="addInitiativeBtn" class="btn btn-gold" style="flex:1;">تسجيل المبادرة</button>
            <button type="button" id="subtractInitiativeBtn" class="btn btn-danger-outline" style="flex:1;">خصم
              النقاط</button>
          </div>
          <p class="form-msg" id="initiativeMsg"></p>
        </form>
      </div>


      <!-- البرنامج الرياضي والثقافي والجماهيري -->
      <div class="panel-box">
        <h4>🏅 البرنامج الرياضي والثقافي والجماهيري</h4>
        <form id="catPointsForm">
          <div class="form-group">
            <label>اختر المجموعة</label>
            <select id="catPointsMegaGroupSelect" class="form-select" required>
              <option value="">اختر المجموعة</option>
              <% megaGroups.forEach(mg=> { %>
                <option value="<%= mg.id %>">
                  <%= mg.name %>
                </option>
                <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="catPointsCategory">البرنامج</label>
            <select id="catPointsCategory" class="form-select" required>
              <option value="">اختر البرنامج</option>
              <option value="cultural">الثقافي</option>
              <option value="sports">الرياضي</option>
              <option value="audience">الجماهيري</option>
            </select>
          </div>
          <div class="form-group">
            <label for="catPointsAmount">عدد النقاط</label>
            <input type="number" id="catPointsAmount" class="form-input" placeholder="أدخل النقاط (بالموجب للإضافة والسالب للخصم)" required>
          </div>
          <button type="button" id="updateCatPointsBtn" class="btn btn-gold" style="width:100%;">تحديث النقاط</button>
          <p class="form-msg" id="catPointsMsg"></p>
        </form>
      </div>

      <!-- تقييم إنجاز الذاتي الأسبوعي -->
      <div class="panel-box">
        <h4>تقييم إنجاز الذاتي الأسبوعي</h4>
        <input type="hidden" id="tasksStudentSelect">
        <div class="form-group">
          <label>اختر الطالب</label>
          <div style="display:flex; gap:10px;">
            <select id="tasksGroupPicker" class="form-select" style="flex:1;">
              <option value="">اختر الأسرة</option>
            </select>
            <select id="tasksStudentPicker" class="form-select" style="flex:1;" disabled>
              <option value="">اختر الطالب</option>
            </select>
          </div>
        </div>
        <div id="knowledgeTasksList" class="knowledge-tasks-list scrollable-weeks"></div>
        <p class="form-msg" id="tasksMsg"></p>
      </div>
    </div>

    <% if (role==='admin' ) { %>
      <!-- إعداد متطلبات الذاتي لكل أسبوع (متطلبان أو ثلاثة، وعدد نقاط كل متطلب) -->
      <div class="panel-box" style="margin-bottom:18px;">
        <h4 style="margin-top:0;">⚙️ ضبط الذاتي الأسبوعي (16 أسبوعاً)</h4>
        <p class="section-desc" style="margin-bottom:12px; font-size:13px;">لكل أسبوع متطلبان أو ثلاثة، بعنوان ونقاط
          مستقلة لكل متطلب — أضف أو احذف متطلبات أي أسبوع بحرية</p>
        <div class="form-group" style="display:flex; gap:10px; align-items:flex-end; margin-bottom:14px;">
          <div style="flex:1;">
            <label for="addTaskWeekSelect">إضافة متطلب لأسبوع</label>
            <select id="addTaskWeekSelect" class="form-select">
              <% for (let w=1; w <=16; w++) { %>
                <option value="<%= w %>">الأسبوع <%= w %>
                </option>
                <% } %>
            </select>
          </div>
          <button type="button" id="addTaskBtn" class="btn btn-outline btn-small">➕ إضافة متطلب</button>
        </div>
        <div id="taskConfigList" class="knowledge-tasks-list scrollable-weeks"></div>
        <button type="button" id="saveTaskConfigBtn" class="btn btn-primary" style="margin-top:12px; width:100%;">حفظ
          الإعدادات</button>
        <p class="form-msg" id="taskConfigMsg"></p>
      </div>
      <% } %>

        <!-- =========================================================
         3) إدارة الطلاب — إدارة فقط
         ========================================================= -->
        <% if (role==='admin' ) { %>
          <hr style="margin: 30px 0; border-color: #e2e8f0;">
          <h4 style="margin-top:0;">🔗 ربط الأسر بالمجموعات الكبرى</h4>
          <form id="assignMegaGroupForm">
            <div class="form-group">
              <label>الأسرة</label>
              <select id="assignGroupId" class="form-select" required>
                <option value="" disabled selected>اختر الأسرة</option>
                <% groups.forEach(g=> { %>
                  <option value="<%= g.id %>">
                    <%= g.name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>المجموعة الكبرى</label>
              <select id="assignMegaGroupId" class="form-select">
                <option value="">بدون مجموعة (إزالة الربط)</option>
                <% megaGroups.forEach(mg=> { %>
                  <option value="<%= mg.id %>">
                    <%= mg.name %>
                  </option>
                  <% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-outline" style="width:100%;" id="assignSubmitBtn">حفظ الربط</button>
            <p class="form-msg" id="assignMsg"></p>
          </form>
          </div>

          <h3 class="panel-group-title">👥 إدارة الطلاب</h3>

          <div class="panel-grid" style="margin-bottom:18px;">
            <div class="panel-box">
              <h4 style="margin-top:0;">➕ إضافة طالب جديد</h4>
              <div class="form-group">
                <label for="newStudentName">اسم الطالب</label>
                <input type="text" id="newStudentName" class="form-input" placeholder="اكتب اسم الطالب...">
              </div>
              <div class="form-group">
                <label for="newStudentGroup">الأسرة</label>
                <select id="newStudentGroup" class="form-select">
                  <option value="">اختر الأسرة</option>
                  <% groups.forEach(g=> { %>
                    <option value="<%= g.id %>">
                      <%= g.name %>
                    </option>
                    <% }) %>
                </select>
              </div>
              <button type="button" id="addStudentBtn" class="btn btn-gold" style="width:100%;">إضافة الطالب</button>
              <p class="form-msg" id="addStudentMsg"></p>

              <hr style="margin:18px 0; border-color:rgba(255,255,255,0.15);">

              <h4 style="margin-top:0;">🗑️ حذف طالب</h4>
              <div class="form-group">
                <label for="deleteStudentName">اسم الطالب</label>
                <input type="text" id="deleteStudentName" class="form-input" placeholder="اكتب اسم الطالب...">
              </div>
              <div class="form-group">
                <label for="deleteStudentGroup">الأسرة</label>
                <select id="deleteStudentGroup" class="form-select">
                  <option value="">اختر الأسرة</option>
                  <% groups.forEach(g=> { %>
                    <option value="<%= g.id %>">
                      <%= g.name %>
                    </option>
                    <% }) %>
                </select>
              </div>
              <button type="button" id="deleteStudentBtn" class="btn btn-danger" style="width:100%;">حذف الطالب</button>
              <p class="form-msg" id="deleteStudentMsg"></p>
            </div>

            <div class="panel-box">
              <h4 style="margin-top:0;">🔀 نقل طالب إلى أسرة أخرى</h4>
              <div class="form-group">
                <label for="moveStudentSearch">اختر الطالب</label>
                <div class="search-box-wrapper" style="margin-bottom:0;">
                  <input type="text" id="moveStudentSearch" class="search-input" placeholder="اكتب اسم الطالب..."
                    autocomplete="off">
                  <div class="search-results" id="moveStudentResults"></div>
                </div>
                <input type="hidden" id="moveStudentSelect">
              </div>
              <div class="form-group">
                <label for="moveStudentGroup">الأسرة الجديدة</label>
                <select id="moveStudentGroup" class="form-select">
                  <option value="">اختر الأسرة</option>
                  <% groups.forEach(g=> { %>
                    <option value="<%= g.id %>">
                      <%= g.name %>
                    </option>
                    <% }) %>
                </select>
              </div>
              <button type="button" id="moveStudentBtn" class="btn btn-gold" style="width:100%;">نقل الطالب</button>
              <p class="form-msg" id="moveStudentMsg"></p>
            </div>
          </div>

          <!-- =========================================================
         4) الإعدادات — إدارة فقط
         ========================================================= -->
          <h3 class="panel-group-title">⚙️ الإعدادات</h3>

          <div class="scores-visibility-box" style="margin-bottom:18px;">
            <div class="scores-status-info">
              <strong>حالة نقاط الطلاب للزوار:</strong>
              <span id="scoresStatusText"
                class="scores-status-badge <%= scoresVisible ? 'badge-visible' : 'badge-hidden' %>">
                <%= scoresVisible ? 'ظاهرة ✅' : 'مخفية 🔒' %>
              </span>
              <small class="scores-status-hint">يؤثر على قسم المجموعات وملف الطالب</small>
            </div>
            <div class="scores-pin-area">
              <input type="password" id="scoresPinInput" class="form-input scores-pin-input" placeholder="أدخل الرمز..."
                maxlength="6" autocomplete="off">
              <button type="button" id="globalToggleScoresBtn"
                class="btn <%= scoresVisible ? 'btn-danger-outline' : 'btn-primary' %>">
                <%= scoresVisible ? '🔒 إخفاء النقاط' : '✅ إظهار النقاط' %>
              </button>
            </div>
            <p class="form-msg" id="scoresToggleMsg" style="margin:0;"></p>
          </div>
          <% } %>

            <!-- =========================================================
         5) جدول كل الطلاب + باركود كل طالب
         ========================================================= -->
            <h3 class="panel-group-title">📊 جميع الطلاب</h3>
            <div class="data-table-wrapper">
              <table class="data-table" id="supervisorStudentTable">
                <thead>
                  <tr>
                    <th>#</th>
                    <th>الاسم</th>
                    <th>المجموعة</th>
                    <th class="col-scores">الذاتي</th>
                    <th class="col-scores">حضور</th>
                    <th class="col-scores">الإجمالي</th>
                    <th>الحضور</th>
                    <th>الجوال</th>
                    <th>الباركود</th>
                  </tr>
                </thead>
                <tbody id="supervisorStudentTableBody">
                  <% students.forEach((s, i)=> { %>
                    <tr data-student-id="<%= s.id %>" data-student-name="<%= s.name %>">
                      <td>
                        <%= i + 1 %>
                      </td>
                      <td>
                        <%= s.name %>
                      </td>
                      <td>
                        <%= s.group_name %>
                      </td>
                      <td class="cell-knowledge col-scores">
                        <%= s.knowledge_points %>
                      </td>
                      <td class="cell-attendance-points col-scores">
                        <%= s.attendance_points %>
                      </td>
                      <td class="cell-total col-scores"><strong>
                          <%= s.total_points %>
                        </strong></td>
                      <td class="cell-attendance">
                        <div class="att-dots">
                          <% sessions.forEach(sess=> {
                            const st = (attendanceMap[s.id] || {})[sess.id];
                            const cls = st === 'حاضر' || st === 'متأخر' ? 'att-present'
                            : st === 'غايب' ? 'att-absent'
                            : 'att-none';
                            const icon = st === 'حاضر' || st === 'متأخر' ? '✓'
                            : st === 'غايب' ? '✗' : '–';
                            %>
                            <span class="att-dot <%= cls %>" title="أسبوع <%= sess.week_number %> <%= sess.day_name %>">
                              <%= icon %>
                            </span>
                            <% }) %>
                        </div>
                      </td>
                      <td>
                        <% if (role==='admin' ) { %>
                          <input type="text" class="form-input phone-input" data-student-id="<%= s.id %>"
                            value="<%= s.guardian_phone || '' %>" placeholder="05xxxxxxxx"
                            style="width:110px; font-size:12px;">
                          <% } else { %>
                            <%= s.guardian_phone || '—' %>
                              <% } %>
                      </td>
                      <td>
                        <button type="button" class="btn-show-barcode" data-barcode="<%= s.barcode %>"
                          data-name="<%= s.name %>">
                          <%= s.barcode %>
                        </button>
                      </td>
                    </tr>
                    <% }) %>
                </tbody>
              </table>
            </div>

            <!-- منطقة عرض/طباعة الباركود المختار -->
            <div id="barcodeModal" class="barcode-modal hidden">
              <div class="barcode-modal-content">
                <button id="closeBarcodeModal" class="btn-close-modal">×</button>
                <h4 id="barcodeModalName"></h4>
                <div id="barcodeModalCanvas"></div>
                <p id="barcodeModalCode" class="barcode-modal-code"></p>
                <button id="printBarcodeBtn" class="btn btn-outline btn-small">طباعة</button>
              </div>
            </div>

  </section>

  <%- include('partials/footer') %>

    <script src="/js/supervisor.js"></script>